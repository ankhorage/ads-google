{
  "name": "@ankhorage/ads-google",
  "version": "0.3.0",
  "description": "Google Ads provider with externally approved, account-scoped mutations.",
  "license": "MIT",
  "homepage": "https://github.com/ankhorage/ads-google#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/ads-google.git"
  },
  "bugs": {
    "url": "https://github.com/ankhorage/ads-google/issues"
  },
  "keywords": [
    "ads",
    "google-ads",
    "ankhorage"
  ],
  "module": "./dist/index.js",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.3.33",
    "@ankhorage/paradox": "^0.1.24",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "docs": "paradox && ankhorage-prettier --write README.md paradox",
    "test": "bun test src",
    "doctor": "ankhorage-structure check .",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version",
    "prepack": "bun run build",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip"
  },
  "dependencies": {
    "@ankhorage/contracts": "^26.3.0",
    "@ankhorage/mcp": "^0.3.0",
    "google-auth-library": "^11.3.2"
  },
  "packageManager": "bun@1.4.2"
}
